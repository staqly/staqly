# Settings of the e2e stack (compose.yml + compose.e2e.yml). Ports differ from
# the defaults so the test stack runs next to your own staqly.
API_PORT=13333
DASHBOARD_PORT=18080
RECEIVER_PORT=19000
PUBLIC_API_URL=http://localhost:13333
# Retry a failed webhook or notification after about a second, not minutes.
WEBHOOK_RETRY_BASE=1s
WEBHOOK_RETRY_MAX=2s
# A delivery in flight during a crash goes out again after 65 s, not 2 minutes (06c-outbox-restart).
WEBHOOK_LEASE=65s
NOTIFY_RETRY_BASE=1s
# An alert is disabled after 3 failed sends in a row (default 10), so it is
# testable within a run.
NOTIFY_MAX_FAILS=3
# ntfy pushes reach the receiver service on the compose network (webhooks and
# schedule endpoints may in local mode anyway).
NOTIFY_ALLOW_PRIVATE=true
# The suite starts in local mode; 07-cloud-mode re-creates the container with
# STAQLY_MODE=cloud and SETUP_TOKEN set in the environment (which wins over
# this file).
STAQLY_MODE=local
SETUP_TOKEN=
# Local mode's access token, fixed so the tests know it (installs make one in DATA_DIR/access_token);
# cloud mode ignores it. lib/stack.ts has the same value.
STAQLY_LOCAL_TOKEN=stk_local_e2etokene2etokene2etokene2etoken
