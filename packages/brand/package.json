{
  "name": "@staqly/brand",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "private": true,
  "description": "Staqly brand pieces shared by the dashboard, docs and landing page: logo, hero demo, site footer, platform marks, brand CSS (source only, transpiled by each Next app)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./analytics": "./src/analytics.tsx",
    "./logo": "./src/logo.tsx",
    "./hero-demo": "./src/hero-demo.tsx",
    "./tokens.css": "./tokens.css",
    "./site.css": "./site.css",
    "./providers": "./src/providers.tsx",
    "./placements": "./src/placements.ts",
    "./site-footer": "./src/site-footer.tsx",
    "./tools": "./src/tools.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "format": "oxlint --fix --quiet; oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "cn": "^0.5.1",
    "posthog-js": "1.444.0",
    "simple-icons": "16.36.0"
  },
  "peerDependencies": {
    "lucide-react": ">=1.50.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/react": "^19.3.0",
    "lucide-react": "^1.66.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "react": "19.3.1",
    "typescript": "^7.0.2"
  }
}
