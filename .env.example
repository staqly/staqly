# Optional overrides for the Compose setup of a checkout (`make dev`, `make up`).
# Everything has a sensible default; copy only the lines you want to change into
# .env and uncomment them. With the image via `docker run`, pass the same
# variables with -e NAME=value or --env-file; `staqly serve` reads them from its
# environment. compose.yml passes every variable below into the container
# except DASHBOARD_ADDR, which only applies to `staqly serve`.

# --- Mode -------------------------------------------------------------------
# local (default): single workspace, no limits; every request needs the access token
#   (made on first start in DATA_DIR/access_token, printed at every start; `server token` prints it).
# cloud: hosted, many workspaces, API keys, plans. See https://docs.staqly.ai/local-vs-cloud.
# STAQLY_MODE=cloud
# SETUP_TOKEN=            # cloud: restrict new accounts to token holders (others join by invitation)
# Cloud mode needs a way to sign in: Google, email codes (the MAIL_* lines) or both.
# GOOGLE_CLIENT_ID=       # cloud: sign-in with Google; redirect URL
# GOOGLE_CLIENT_SECRET=   #   <PUBLIC_DASHBOARD_URL>/api/v1/auth/google/callback (docs: Accounts, workspaces and roles)
# GOOGLE_REDIRECT_URL=    # cloud: only when it differs from the line above
# GOOGLE_ISSUER=          # tests only: a fake Google's issuer (default https://accounts.google.com)
# AUTH_DEV_SIGNIN=true    # development and tests only: cloud without Google or mail (email codes shown to tests,
#                         #   setup token / API key sign-in kept)
# MAIL_SMTP_HOST=         # cloud: sign-in codes and invitation emails (also MAIL_SMTP_PORT=587,
# MAIL_FROM=              #   MAIL_SMTP_USERNAME, MAIL_SMTP_PASSWORD, MAIL_SMTP_TLS=starttls|tls|none)
# COOKIE_SECURE=true      # cloud behind HTTPS
# TRUST_PROXY=true        # cloud behind your reverse proxy (client IP from X-Forwarded-For)

# --- Database ---------------------------------------------------------------
# Local mode keeps everything in SQLite in DATA_DIR (nothing to set up).
# Cloud mode REQUIRES PostgreSQL 16+ and refuses to start without it (no SQLite fallback):
# DATABASE_URL=postgres://staqly:password@db.example.com:5432/staqly?sslmode=require
#                         # a search_path=name parameter puts staqly in its own schema (created on start)
# DATABASE_PATH=./data/workspace.db   # local mode: the SQLite file (default DATA_DIR/workspace.db)
# DATA_DIR=./data         # where staqly keeps its files: the database, access token, keys, uploads, exports
#                         #   (the image uses /data, `staqly serve` your user data directory)

# --- Ports (defaults: API 3333 on localhost only, dashboard 8080 on your network) ---
# API_PORT=3333
# DASHBOARD_PORT=8080
# DASHBOARD_ADDR=127.0.0.1:8080   # without Docker: also serve the dashboard from the API process (`staqly serve` and the image set it)
# ADDR=127.0.0.1:3333     # the API's listen address inside the process (API_PORT maps it in Compose)
# DASHBOARD_EXPOSED=true  # the dashboard is reachable beyond this computer (default: when DASHBOARD_ADDR isn't loopback)

# --- Public URLs ------------------------------------------------------------
# PUBLIC_API_URL=http://localhost:3333     # media links in API responses/webhooks; API URL shown in dashboard snippets
#                                          # (Compose default: http://localhost:$API_PORT)
#                                          # (the dashboard reads it from the API at runtime)
# PUBLIC_DASHBOARD_URL=http://192.168.1.23:8080  # dashboard URL in "Connect a device" QR codes and the token link (LAN IP or domain)
# CORS_ALLOWED_ORIGINS=none                 # cloud: origins allowed to call the API with an API key (default https://docs.staqly.ai, the docs playground)
# STAQLY_LOCAL_TOKEN=stk_local_...          # local mode: fix the access token (tests, CI; at least 32 characters, starts with
#                                          # stk_local_) instead of the one made in DATA_DIR/access_token; `server token --rotate`
#                                          # then refuses. (LOCAL_TRUSTED_PEERS, LOCAL_ALLOWED_HOSTS and LOCAL_ALLOWED_ORIGINS
#                                          # are gone: no request is keyless any more.)

# --- Media storage (https://docs.staqly.ai/self-hosting/storage) ------------
# STORAGE_DRIVER=disk           # disk (default: files in UPLOAD_DIR) | s3 (any S3-compatible bucket)
# UPLOAD_DIR=                   # disk: default $DATA_DIR/uploads
# S3_ENDPOINT=                  # s3: https://s3.eu-central-1.amazonaws.com, https://<account>.r2.cloudflarestorage.com, ...
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false     # true for MaxIOFS, MinIO, Garage and most self-hosted servers
# S3_PREFIX=                    # optional folder in the bucket, e.g. staqly/
# S3_PUBLIC_URL=                # optional public URL of the bucket (a CDN); else platforms get signed links
# S3_SIGN_ENDPOINT=             # optional: the address platforms reach the bucket at, when staqly uses another (default S3_ENDPOINT)
# S3_CREATE_BUCKET=false        # create a missing bucket on start (dev stacks)
# The dev stack (make dev) runs MaxIOFS and sets these itself (compose.dev.yml).

# --- Limits & webhooks ------------------------------------------------------
# MAX_UPLOAD_MB=100
# WEBHOOK_ALLOW_PRIVATE=true    # deliver to LAN / Docker-network receivers (e.g. n8n).
#                               # Default: true in local mode, false in cloud mode.
# WEBHOOK_ALLOW_LOOPBACK=false  # deliver to 127.0.0.1 (only when the API runs outside Docker)
# WEBHOOK_RETRY_BASE=15s
# WEBHOOK_RETRY_MAX=1h          # longest wait between delivery attempts
# WEBHOOK_LEASE=2m              # a delivery in flight when the process died is sent again after this (above 1m)
# SESSION_TTL=720h              # how long a dashboard sign-in lasts
# LOG_LEVEL=info                # debug | info | warn | error (invalid values refuse to start)
# LOG_FORMAT=json               # json (default; for Logpush/Loki/Datadog) | text

# --- Observability (https://docs.staqly.ai/self-hosting/monitoring) ----------------------------------
# METRICS_TOKEN=                # bearer token for /metrics from outside this machine (e.g. Prometheus in Docker)
# LOCAL_USER_NAME=Jane          # your name in the activity log of a local install (default: login name)
# PROCESSING_TIMEOUT=1h         # default: a post on "your own automation" with no result after this fails (0 = never); a collection can set 1m-24h
# SENTRY_DSN=                   # report errors (5xx, panics, failing workers) to Sentry; off when empty
# SENTRY_ENVIRONMENT=production
# POSTHOG_KEY=                  # product analytics + error reports to your own PostHog project (project token phc_...); off when empty
# POSTHOG_HOST=https://eu.i.posthog.com   # or https://us.i.posthog.com, or your PostHog reverse proxy
# POSTHOG_ENVIRONMENT=production          # set development/test on non-production servers
# Cloud billing through Stripe (key and webhook secret set = billing enabled; test keys work):
# STRIPE_SECRET_KEY=sk_test_51ExampleKey
# STRIPE_WEBHOOK_SECRET=whsec_from_the_stripe_webhook_endpoint
# Each plan (starter, plus, pro, business) is one recurring price per interval in your Stripe account, found by
# its lookup key staqly_<plan>_<month|year> (e.g. staqly_plus_year). Optional: pin a price by its id instead
# (leave these unset to use lookup keys; a value that isn't a price id is ignored):
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_STARTER_YEARLY=price_...
# STRIPE_PRICE_PLUS_MONTHLY=price_...
# STRIPE_PRICE_PLUS_YEARLY=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_YEARLY=price_...
# STRIPE_MANAGED_PAYMENTS=true   # Stripe Managed Payments: Stripe (Link) is the merchant of record and handles tax, invoices and disputes; enable it in the Stripe Dashboard first
# TRIAL_PLAN=starter              # without Stripe only: plan of the server-side 7-day trial (with Stripe the trial is Stripe's, card required); tests use pro
# RATE_LIMIT_DISABLED=true
# RATE_LIMIT_PER_MINUTE=10        # sensitive unauthenticated endpoints, per IP
# RATE_LIMIT_BURST=10             # default: RATE_LIMIT_PER_MINUTE
# RATE_LIMIT_AUTH_PER_MINUTE=600  # cloud: per API key / session
# RATE_LIMIT_AUTH_BURST=100

# --- Retention (https://docs.staqly.ai/self-hosting/data-export) ------------------------------------------
# RETENTION_DELIVERIES_DAYS=30
# RETENTION_EVENTS_DAYS=0         # 0 = keep activity history forever
# RETENTION_NOTIFICATIONS_DAYS=30 # notification delivery history
# RETENTION_AGENTS_DAYS=30        # agents / API connections not seen for N days are removed

# --- Channels and platforms ------------------------------------------------------
# STAQLY_SECRET_KEY=            # seals channel credentials and developer app secrets (base64, 32 bytes, `openssl rand -base64 32`).
#                               # Unset: DATA_DIR/secret.key is created on first start; back it up with the data directory.
# The developer apps of OAuth platforms: see the Platforms section at the end.

# JOB_CONCURRENCY=4              # background jobs run at once (publishing, schedule runs); at most half per workspace while others wait

# --- Design editor: AI and stock photos (https://docs.staqly.ai/dashboard/design-editor) -----------------
# AI tools run on the server's provider keys (never a workspace's); without one they are hidden.
# AI_FAL_KEY=                                # fal.ai API key: every AI tool
# AI_HIGGSFIELD_API_KEY=                     # Higgsfield <key id>:<key secret>: new pictures and videos
# AI_MEDIA_PROVIDERS=fal,higgsfield          # the order pictures and videos try them in (higgsfield,fal: Higgsfield first)
# AI_ASSISTANT_MODEL=google/gemini-2.5-flash  # the dashboard assistant's model (via fal.ai's OpenRouter router)
# The assistant on any OpenAI-compatible endpoint instead (OpenAI, OpenRouter, DigitalOcean, Ollama, LiteLLM):
# AI_ASSISTANT_BASE_URL=https://api.openai.com/v1   # the API base; .../chat/completions is called
# AI_ASSISTANT_API_KEY=                              # sent as Bearer; empty for a local server without one
# AI_ASSISTANT_PRICES=0.30,2.50                      # USD per million input,output tokens of this endpoint only
# AI_PRICES_FILE=/data/ai-prices.json                # model prices over the built-in list (apps/api/internal/app/ai_prices.json)
# A cheaper model when the workspace's AI allowance ran out or the first refused (its quota, an outage); same four:
# AI_ASSISTANT_FALLBACK_BASE_URL=https://inference.do-ai.run/v1
# AI_ASSISTANT_FALLBACK_MODEL=
# AI_ASSISTANT_FALLBACK_API_KEY=
# AI_ASSISTANT_FALLBACK_PRICES=
# AI_ASSISTANT_BROWSER_MODEL=Qwen2.5-3B-Instruct-q4f16_1-MLC   # last resort: WebLLM in the browser, text only
# AI_OPERATIONS=                             # offered tools, e.g. generate,edit,erase (default: all)
# AI_PRICES=                                 # price overrides, e.g. fal-ai/flux/schnell=0.004
# AI_FAL_BASE_URL=https://queue.fal.run      # a proxy or tests
# AI_HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
# PIXABAY_API_KEY=                           # stock photos in the design editor (pixabay.com/api/docs, after signing in)

# --- Alerts (https://docs.staqly.ai/automation/alerts) -----------------------------------------------------
# NOTIFY_SECRET_KEY=              # encrypts alert secrets (bot tokens, SMTP passwords). If unset, a key is
#                                 # generated in <data dir>/notify_secret.key (/data in Docker; back it up with the database).
# NOTIFY_ALLOW_LOOPBACK=false     # let alerts post to this computer (127.0.0.1); tests and local ntfy only
# NOTIFY_POLL_INTERVAL=2s         # how often the alert worker looks for new events
# NOTIFY_ALLOW_PRIVATE=false      # let alerts post to LAN addresses (e.g. a self-hosted ntfy).
#                                 # Default false; keep it false in cloud mode.
# NOTIFY_DISABLED_GRACE=24h       # a disabled alert keeps queued messages this long, then they are skipped
# NOTIFY_CONCURRENCY=8            # alerts delivered to at once
# NOTIFY_MAX_ATTEMPTS=5           # attempts per notification
# NOTIFY_RETRY_BASE=30s           # wait before the first retry, doubling each time
# NOTIFY_MAX_FAILS=10             # consecutive failures that disable an alert

# --- Container resources (compose.yml) ------------------------------------------
# The staqly container runs read-only, without capabilities, with these limits.
# STAQLY_MEM_LIMIT=640m
# STAQLY_PIDS_LIMIT=256

# --- Platforms (https://docs.staqly.ai/channels/developer-apps) ------------------------------------------
# One block per platform, locally and in the cloud. PROVIDER_<ID>_ENABLED=false hides the platform and turns it
# off (no tile, no connecting, no publishing). Enabled but without its app's keys, an OAuth platform shows as
# soon. Platforms not built yet show as soon whatever is set here.
# Your own automation (n8n, a script)
PROVIDER_CUSTOM_ENABLED=true

# X (developer.x.com: OAuth 2.0 Client ID and Client Secret)
PROVIDER_X_ENABLED=true
PROVIDER_X_CLIENT_ID=
PROVIDER_X_CLIENT_SECRET=

# LinkedIn profile (an app with Share on LinkedIn and Sign In with OpenID Connect: Client ID, Primary Client Secret)
PROVIDER_LINKEDIN_ENABLED=true
PROVIDER_LINKEDIN_CLIENT_ID=
PROVIDER_LINKEDIN_CLIENT_SECRET=

# LinkedIn Page (a second app with only the Community Management API: Client ID, Primary Client Secret)
PROVIDER_LINKEDIN_PAGE_ENABLED=true
PROVIDER_LINKEDIN_PAGE_CLIENT_ID=
PROVIDER_LINKEDIN_PAGE_CLIENT_SECRET=

# Reddit (a "web app" at reddit.com/prefs/apps; Reddit must approve API access: app id and secret)
PROVIDER_REDDIT_ENABLED=true
PROVIDER_REDDIT_CLIENT_ID=
PROVIDER_REDDIT_CLIENT_SECRET=

# Instagram (Instagram login: Business or Creator account, no Facebook Page; Instagram App ID and secret)
PROVIDER_INSTAGRAM_ENABLED=true
PROVIDER_INSTAGRAM_CLIENT_ID=
PROVIDER_INSTAGRAM_CLIENT_SECRET=

# Instagram Business (through a Facebook Page): App ID and App secret of a Meta app with Facebook Login for Business
PROVIDER_INSTAGRAM_BUSINESS_ENABLED=true
PROVIDER_INSTAGRAM_BUSINESS_CLIENT_ID=
PROVIDER_INSTAGRAM_BUSINESS_CLIENT_SECRET=

# Facebook Page: App ID and App secret of a Meta app with Facebook Login for Business (developers.facebook.com/apps)
PROVIDER_FACEBOOK_ENABLED=true
PROVIDER_FACEBOOK_CLIENT_ID=
PROVIDER_FACEBOOK_CLIENT_SECRET=

# Threads: Threads app ID and secret of a Meta app with the Threads API use case
PROVIDER_THREADS_ENABLED=true
PROVIDER_THREADS_CLIENT_ID=
PROVIDER_THREADS_CLIENT_SECRET=

# YouTube: an OAuth client (Web application) in Google Cloud with the YouTube Data API v3 enabled
PROVIDER_YOUTUBE_ENABLED=true
PROVIDER_YOUTUBE_CLIENT_ID=
PROVIDER_YOUTUBE_CLIENT_SECRET=

# Google Business Profile: an OAuth client in a Google Cloud project Google approved for the Business Profile APIs
PROVIDER_GOOGLE_BUSINESS_ENABLED=true
PROVIDER_GOOGLE_BUSINESS_CLIENT_ID=
PROVIDER_GOOGLE_BUSINESS_CLIENT_SECRET=

# TikTok (developers.tiktok.com: Login Kit and Content Posting API with Direct Post; Client key and secret)
PROVIDER_TIKTOK_ENABLED=true
PROVIDER_TIKTOK_CLIENT_ID=
PROVIDER_TIKTOK_CLIENT_SECRET=

# Pinterest (developers.pinterest.com/apps: App id and App secret key; Standard access for public pins)
PROVIDER_PINTEREST_ENABLED=true
PROVIDER_PINTEREST_CLIENT_ID=
PROVIDER_PINTEREST_CLIENT_SECRET=

# Dribbble (dribbble.com/account/applications/new: Client ID and Client Secret)
PROVIDER_DRIBBBLE_ENABLED=true
PROVIDER_DRIBBBLE_CLIENT_ID=
PROVIDER_DRIBBBLE_CLIENT_SECRET=

# Discord (each channel brings its own channel webhook)
PROVIDER_DISCORD_ENABLED=true

# Slack (api.slack.com/apps > Basic Information > App Credentials; Public Distribution on)
PROVIDER_SLACK_ENABLED=true
PROVIDER_SLACK_CLIENT_ID=
PROVIDER_SLACK_CLIENT_SECRET=

# Kick (kick.com > Settings > Developer > Create App: Client ID and Client Secret)
PROVIDER_KICK_ENABLED=true
PROVIDER_KICK_CLIENT_ID=
PROVIDER_KICK_CLIENT_SECRET=

# Twitch (dev.twitch.tv/console/apps, a Confidential client: Client ID and Client Secret)
PROVIDER_TWITCH_ENABLED=true
PROVIDER_TWITCH_CLIENT_ID=
PROVIDER_TWITCH_CLIENT_SECRET=

# Mastodon (each channel brings its own server and access token)
PROVIDER_MASTODON_ENABLED=true

# Bluesky (each channel brings its own handle and app password)
PROVIDER_BLUESKY_ENABLED=true

# Lemmy (each channel signs in to its own server)
PROVIDER_LEMMY_ENABLED=true

# Farcaster
PROVIDER_FARCASTER_ENABLED=true

# Telegram (each channel brings its own bot token and chat)
PROVIDER_TELEGRAM_ENABLED=true
PROVIDER_TELEGRAM_BOT_TOKEN=          # the server's own bot (@BotFather): people add it to a chat and send /connect CODE

# Nostr (each channel brings its own key and relays)
PROVIDER_NOSTR_ENABLED=true

# Medium (each channel brings its own integration token)
PROVIDER_MEDIUM_ENABLED=true

# Dev.to (each channel brings its own API key)
PROVIDER_DEVTO_ENABLED=true

# Hashnode (each channel brings its own personal access token)
PROVIDER_HASHNODE_ENABLED=true

# WordPress (each channel brings its own site and application password)
PROVIDER_WORDPRESS_ENABLED=true

# listmonk (each channel brings its own server, API user and token)
PROVIDER_LISTMONK_ENABLED=true

# Moltbook (each channel brings its own agent API key)
PROVIDER_MOLTBOOK_ENABLED=true

# Whop (each channel brings its own account API key)
PROVIDER_WHOP_ENABLED=true

# Skool
PROVIDER_SKOOL_ENABLED=true

# MeWe: App ID (client id) and API key (client secret) of a Standalone app at dev.mewe.com (beta, MeWe reviews apps)
PROVIDER_MEWE_ENABLED=true
PROVIDER_MEWE_CLIENT_ID=
PROVIDER_MEWE_CLIENT_SECRET=

# Tumblr (tumblr.com/oauth/apps with an OAuth2 redirect URL: OAuth consumer key and secret)
PROVIDER_TUMBLR_ENABLED=true
PROVIDER_TUMBLR_CLIENT_ID=
PROVIDER_TUMBLR_CLIENT_SECRET=
