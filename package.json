{
  "name": "staqly",
  "private": true,
  "description": "staqly monorepo: API, CLI, dashboard, docs, landing page, SDKs (Turborepo + pnpm)",
  "packageManager": "pnpm@11.5.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
