{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "AGENTS.md",
    "lib/api-types.ts",
    "package-lock.json",
    ".next/**",
    "next-env.d.ts",
    "lib/opengpex/**",
    "public/ext/**"
  ],
  "jsxSingleQuote": false,
  "sortImports": {
    "groups": ["builtin", "external", "internal", ["parent", "sibling", "index"], "style", "unknown"],
    "newlinesBetween": true
  }
}
