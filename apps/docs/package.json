{
  "name": "@staqly/docs",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "private": true,
  "description": "staqly user documentation (Fumadocs, static export)",
  "scripts": {
    "dev": "next dev -p 8090",
    "build": "next build && node scripts/markdown-files.mjs && node scripts/check-links.mjs",
    "preview": "pnpm dlx serve@latest out -l 8090",
    "check-links": "node scripts/check-links.mjs",
    "lint": "oxlint --deny-warnings",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "oxlint --fix --quiet; oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@staqly/brand": "workspace:*",
    "cn": "^0.5.2",
    "fumadocs-core": "16.18.3",
    "fumadocs-mdx": "15.5.3",
    "fumadocs-openapi": "12.6.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.18.3",
    "geist": "^1.9.2",
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@staqly/check-links": "workspace:*",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
